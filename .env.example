# Local development only. Use a unique, secret value in deployed environments.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: create this database and role before running migrations.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Local MinIO (Docker Compose). Generate a secret before starting.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sanaap-local
MINIO_SECRET_KEY=
MINIO_BUCKET=insurance-documents
# TODO(saeed): set it to True
MINIO_SECURE=false
