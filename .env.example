# Local development only. Use a unique, secret value in deployed environments.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Compose creates the database and role. Set a password before starting.
POSTGRES_DB=sanaap
POSTGRES_USER=sanaap
POSTGRES_PASSWORD=
# Docker service hostname. Use localhost when running Django on the host.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Nginx exposes the containerized API here.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8000

# Local MinIO (Docker Compose). Generate a secret before starting.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sanaap-local
MINIO_SECRET_KEY=
# Compose expands these aliases so MinIO and Django use matching credentials.
MINIO_ROOT_USER=${MINIO_ACCESS_KEY:?Set MINIO_ACCESS_KEY in .env}
MINIO_ROOT_PASSWORD=${MINIO_SECRET_KEY:?Set MINIO_SECRET_KEY in .env}
MINIO_BUCKET=insurance-documents
MINIO_SECURE=false
# Client-facing address for signed URLs; never use minio:9000 here.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1
MINIO_UPLOAD_URL_TTL=300

# Retain document bytes after API deletion. Schedule purge_deleted_files separately.
FILE_RETENTION_DAYS=30
# Completion allowed for one day; temporary uploads expire after eight days.
FILE_UPLOAD_COMPLETION_TTL=86400
MINIO_STAGING_EXPIRATION_DAYS=8

# Nginx container listener and HTTP transport (keep TCP for HTTP).
NGINX_PORT=80
HTTP_PROTOCOL=tcp
